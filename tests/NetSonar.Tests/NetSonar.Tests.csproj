<Project Sdk="MSTest.Sdk/4.3.3">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Use the VSTest runner instead of Microsoft.Testing.Platform so IDE test discovery works. -->
    <UseVSTest>true</UseVSTest>
    <!-- Override the package versions MSTest.Sdk injects; adding PackageReference items here would duplicate them (NU1504). -->
    <MicrosoftNETTestSdkVersion>18.10.1</MicrosoftNETTestSdkVersion>
    <MSTestVersion>4.5.1</MSTestVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetSonar\NetSonar.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="..\..\src\NetSonar\Localization\Strings*.resx"
      Link="Localization\%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.NET.Test.Sdk">
      <Version>18.10.1</Version>
    </PackageReference>
    <PackageReference Update="MSTest.TestAdapter">
      <Version>4.5.1</Version>
    </PackageReference>
    <PackageReference Update="MSTest.TestFramework">
      <Version>4.5.1</Version>
    </PackageReference>
  </ItemGroup>
</Project>
