<Application
  x:Class="NetSonar.Avalonia.App"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converters="clr-namespace:NetSonar.Avalonia.Converters"
  xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
  xmlns:suki="https://github.com/kikipoulet/SukiUI"
  xmlns:avalonia="clr-namespace:NetSonar.Avalonia"
  xmlns:viewModels="clr-namespace:NetSonar.Avalonia.ViewModels"
  RequestedThemeVariant="Default"
  x:DataType="viewModels:AppViewModel"
>
  <!--  "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options.  -->

  <Application.Resources>
    <converters:RawEnumToCollectionConverter x:Key="RawEnumToCollectionConverter" />
    <converters:FromStringToEnumConverter x:Key="FromStringToEnumConverter" />
    <converters:EnumToCollectionConverter x:Key="EnumToCollectionConverter" />
    <converters:FromValueDescriptionToEnumConverter x:Key="FromValueDescriptionToEnumConverter" />
    <converters:LocalizedFallbackConverter x:Key="LocalizedFallbackConverter" />
    <converters:LocalizedStringFormatConverter x:Key="LocalizedStringFormatConverter" />
    <converters:LocalizedStatusConverter x:Key="LocalizedStatusConverter" />
    <converters:LocalizedStatusComparer x:Key="LocalizedStatusComparer" />
    <converters:SpeedTestGridConverter x:Key="SpeedTestGridConverter" />
    <converters:FileSizeNormalizeConverter x:Key="FileSizeNormalize" />
    <converters:InternetSpeedNormalizeConverter x:Key="InternetSpeedNormalize" />
    <converters:BoolErrorGridRowBackgroundConverter x:Key="BoolErrorGridRowBackground" />
    <FluentTheme x:Key="FluentTheme">
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" />
        <ColorPaletteResources x:Key="Dark" />
      </FluentTheme.Palettes>
    </FluentTheme>
  </Application.Resources>

  <Application.Styles>
    <suki:SukiTheme ThemeColor="Blue" />
    <materialIcons:MaterialIconStyles />
    <StyleInclude Source="avares://Avalonia.Controls.TreeDataGrid/Themes/Generic.axaml" />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.v2.xaml" />
    <StyleInclude Source="avares://NetSonar.Avalonia/Assets/Styles/AppStyles.axaml" />
    <StyleInclude Source="avares://NetSonar.Avalonia/Assets/Styles/TreeDataGrid.axaml" />
    <StyleInclude Source="avares://NetSonar.Avalonia/Assets/Styles/ProDataGrid.axaml" />
  </Application.Styles>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon
        Icon="/Assets/NetSonar.ico"
        ToolTipText="{Binding Source={x:Static avalonia:App.SoftwareWithVersion}}"
        Command="{Binding ToggleApplicationVisibilityCommand}"
        IsVisible="{Binding AppSettings.IsTrayVisible}"
      >
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem
              Header="{Binding TrayShow}"
              Command="{Binding ShowApplicationCommand}"
            />
            <NativeMenuItemSeparator />
            <NativeMenuItem
              Header="{Binding PingsSummary}"
              IsVisible="{Binding PingsSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            />
            <NativeMenuItem Header="{Binding TrayOptions}">
              <NativeMenu>
                <NativeMenuItem
                  Header="{Binding TrayStartWithSystem}"
                  ToggleType="CheckBox"
                  IsChecked="{Binding AppSettings.RunOnStartup, Mode=TwoWay}"
                />

                <NativeMenuItemSeparator />

                <NativeMenuItem
                  Header="{Binding TrayThemeSystem}"
                  Command="{Binding SetThemeSystemCommand}"
                />
                <NativeMenuItem
                  Header="{Binding TrayThemeLight}"
                  Command="{Binding SetThemeLightCommand}"
                />
                <NativeMenuItem
                  Header="{Binding TrayThemeDark}"
                  Command="{Binding SetThemeDarkCommand}"
                />
              </NativeMenu>
            </NativeMenuItem>

            <NativeMenuItemSeparator />
            <NativeMenuItem
              Header="{Binding TrayExit}"
              Command="{Binding ExitApplicationCommand}"
            />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
